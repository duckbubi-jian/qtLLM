{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "CPU Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "cuda-release-vs2019",
      "displayName": "CUDA Release (VS 2019, RTX 3090)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "QTLLM_ENABLE_CUDA": "ON",
        "CMAKE_CUDA_ARCHITECTURES": "86"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cuda-release-vs2019",
      "configurePreset": "cuda-release-vs2019"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-release-vs2019",
      "configurePreset": "cuda-release-vs2019",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
