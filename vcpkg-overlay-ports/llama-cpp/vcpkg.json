{
  "name": "llama-cpp",
  "version": "9030",
  "port-version": 3,
  "description": "LLM inference in C/C++ with its revision-matched ggml",
  "homepage": "https://github.com/ggml-org/llama.cpp",
  "license": "MIT",
  "supports": "!uwp",
  "dependencies": [
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable the CUDA backend for NVIDIA GPUs",
      "supports": "!(windows & staticcrt)",
      "dependencies": [
        "cuda"
      ]
    }
  }
}
